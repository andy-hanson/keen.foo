import
	keen/io/path
	../html
	../page-template

download html()
	page-template "download.html", "download",
		main: download-main

-download-main html[]()
	- h1 "Download"
	- p "{download-link "./bin/keen.tar.xz"} (all platforms)"

	- section "Setting up Keen",
		- subsection "Prerequisites",
			- p "You need a Java runtime on your system."
			- p quote
				You may also want to install Node.js to run JavaScript tests locally.
				This isn't needed if you will always run in the browser.

		- subsection "Install",
			- code-block quote
				cd ~/Downloads
				mkdir -p keen
				tar --extract --directory=keen --xz --file=keen.tar.xz
				rm keen.tar.xz
				echo 'export PATH="$HOME/Downloads/keen/bin:$PATH"' >> ~/.bashrc
				source ~/.bashrc
				keen

		- subsection "Uninstall",
			- code-block quote
				rm -r ~/Downloads/keen
				sed -i '/export PATH=\"\\$HOME\\/Downloads\\/keen\\/bin:\\$PATH\"/d' ~/.bashrc

	- section "Setting up your editor",
		- subsection "VSCode",
			- p "The VSCode extension includes syntax highlighting, hover, go-to-definition, find-references, etc."
			- download-link "./bin/keen.vsix"
			- code-block quote
				cd ~/Downloads
				code --install-extension keen.vsix
				rm keen.vsix
			- p quote
				Editor features will only work when {code "keen"} is in your {code "PATH"}.
				(See install instructions above.)

		- subsection "Other editors",
			- p "{link "https://github.com/andy-hanson/keen/issues", "Ask"} if you want support for a different editor."

-download-link html-node(target string)
	link target, (class: "download"),
		- keen-icon "download"
		- node "code", (), (target.base-name,)
