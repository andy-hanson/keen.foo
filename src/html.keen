colon html-node()
	code ": "
comma html-node()
	code ", "
parens html-node()
	code "()"
braces html-node()
	keyword "\{\}"
lparen html-node()
	code "("
rparen html-node()
	code ")"
parenthesized html[](a html[])
	- lparen
	-- a
	- rparen
lbracket html-node()
	code "["
rbracket html-node()
	code "]"
bracketed html[](a html[])
	- lbracket
	-- a
	- rbracket
lbrace html-node()
	code "\{"
rbrace html-node()
	code "\}"
sp html-node()
	code " "

key-value html[]()
	"{lparen}{key}{comma}{value}{rparen}"
value-subscript-key html[]()
	"{value}{lbracket}{key}{rbracket}"

| Use an enum to ensure intro links are valid.
| The enum order is the intro order.
intro-page enum
	index
	functions
	expressions
	types
	ifs
	overloading
	new_
	tuples
	records
	mutability
	strings
	kid
	operators
	options
	matches
	enums
	loops
	unions
	interfaces
	type-parameters
	specs
	lambdas
	iteration
	collections
	exceptions
	modules
	visibility
	configs
	unsafe
	globals
	targets
	java
	js
	tests
	parallel
	contexts
	dos
	more-overloading
	misc
	end
show string(a intro-page)
	show to::symbol a
next intro-page?(a intro-page)
	to a.to::nat + 1

title string(a intro-page)
	match a
	as collections then "Collections"
	as configs then "\"config.kid\""
	as contexts then "Contexts"
	as dos then "\"do\" expressions"
	as end then "Conclusion"
	as enums then "Enums and flags"
	as exceptions then "Exceptions"
	as expressions then "Basic expressions"
	as functions then "Functions"
	as globals then "Global side effects"
	as ifs then "\"if\" expressions"
	as index then "Commands"
	as interfaces then "Interfaces and variants"
	as iteration then "Iteration"
	as java then "Java"
	as js then "JavaScript"
	as kid then "Kid"
	as lambdas then "Lambdas"
	as loops then "Loops"
	as matches then "\"match\" expressions"
	as misc then "Miscellaneous"
	as modules then  "Modules"
	as more-overloading then "Advanced overloading"
	as mutability then "Mutability"
	as new_ then "\"new\" functions"
	as operators then "Operators"
	as options then "Options"
	as overloading then "Overloading"
	as parallel then "Parallelism"
	as records then "Records"
	as specs then "Specs"
	as strings then "String literals"
	as targets then "Targets"
	as tests then "Tests"
	as tuples then "Tuples"
	as type-parameters then "Type parameters"
	as types then "Basic types"
	as unions then "Unions"
	as unsafe then "Unsafe code"
	as visibility then "Visibility"

path string(a intro-page)
	"intro/{a}.html"
