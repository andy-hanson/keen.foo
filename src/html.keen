std-module html-node(module-path string)
	link "/doc/{module-path}.html", "{module-path}"
std-function html-node(module-path string, function-name string)
	link (module-export-path module-path, function-name), "{function function-name}"
std-type html-node(module-path string, type-name string)
	link (module-export-path module-path, type-name), "{type type-name}"
std-spec html-node(module-path string, spec-name string)
	std-type module-path, spec-name
-module-export-path string(module-path string, export-name string)
	"/doc/{module-path}.html#{export-name}"

col-type html-node(type-name string)
	std-type "keen/col/{type-name}", type-name

