import
	keen/io/duration: duration, milliseconds
	keen/js
	keen/js/dom

debouncer record mut
	-msec float
	-timeout mut js-any
new debouncer(time duration) js
	msec: time.milliseconds
	timeout: null
with-block void(a debouncer, action void mut()) global, js
	do trusted
	_ = call js-global["clearTimeout"], a.timeout
	a.timeout := call js-global["setTimeout"], action.to, a.msec.to

get-child-text string(node node) js
	child-nodes = child-nodes node
	assert child-nodes.size == 1
	get-text-from-node child-nodes[0]
-get-text-from-node string(node node) js
	do trusted
	assert instanceof node, js-global["Text"]
	node["data"].to
