import
	keen/parse
	../../keen/app/frontend/parse/parse
	../../keen/app/model/ast
	../../keen/app/model/parse-diag
	../../keen/app/model/source-range
	../../keen/lib/private/parse-util
	./syntax-translate-protocol

syntax-translate syntax-translate-result(params syntax-translate-params)
	if contains params.source, "\n"
		"", (0,)
	elif params.from-language == params.to-language
		params.source, ()
	elif params.to-language == keen
		expr, diags = parse-java-expr params.source
		output: with out in build
			translate-to-keen out, expr, root, ()
		diagnostics: diags
	elif params.from-language == keen
		res = parse-single-line-expression params.source
		result mut = ""
		diagnostics pos[] = with diags-out in build
			for x in res.diags
				diags-out ~= x.range.start
			result := with out in build
				translate-keen-to-c out, diags-out, res.expr
		result, diagnostics
	else
		throw unreachable

-translate-keen-to-c void(out char8 builder, diags-out pos builder, a expr-ast)
	match a
	as call-ast-dot
		translate-call-to-c out, diags-out, a.fun-name.name, (a.left,)
	as call-ast-infix
		translate-call-to-c out, diags-out, a.fun-name.name, a.args
	as call-ast-prefix
		translate-call-to-c out, diags-out, a.fun-name.name, a.args
	as name-and-range
		out ~~= a.name.to
		if is-function-name a.name
			out ~~= "()"
	as parenthesized-ast
		translate-keen-to-c out, diags-out, a.inner
	else
		diags-out ~= a.range.start
-translate-call-to-c void
	out char8 builder
	diags-out pos builder
	fun-name symbol
	args expr-ast[]
do
	out ~~= fun-name.to
	write-parenthesized out, args, of x, _
		translate-keen-to-c out, diags-out, x

-is-function-name bool(a symbol)
	a == "f" or a == "g" or a == "h"

-output-c-or-java void(out char8 builder, a java-expr)
	match a
	as java-bogus
		out ~~= "bogus"
	as symbol
		out ~~= a.to
	as java-call
		output-c-or-java out, a.called
		write-parenthesized out, a.args, of arg, _
			output-c-or-java out, arg
	as java-dot
		output-c-or-java out, a.left
		out ~= "."
		out ~~= a.name.to

-translate-between-c-or-java java-expr(a java-expr, output-java bool)
	match a
	as java-bogus
		a
	as java-call
		match called = a.called
		as java-bogus
			a
		as symbol
			if output-java and not is-empty a.args
				called:
					arg0 = translate-between-c-or-java a.args[0], output-java
					translate-between-c-or-java (java-dot arg0, called), output-java
				args: for arg in a.args[1 .. end]
					translate-between-c-or-java arg, output-java
			else
				a
		as java-call
			a
		as java-dot
			if output-java
				a
			else
				java-call called.name,
					- translate-between-c-or-java called.left, output-java
					-- for arg in a.args then translate-between-c-or-java arg, output-java
	as java-dot
		a
	as symbol
		a

-write-parenthesized[elem] void(out char8 builder, values elem array-view, f void mut(x elem, pos position))
	out ~= "("
	write-with-commas out, values, f
	out ~= ")"
-write-with-commas[elem] void(out char8 builder, values elem array-view, f void mut(x elem, pos position))
	for i, x in with-index values
		if i != 0
			out ~~= ", "
		f[x, if i == values.size - 1 then root else non-last-arg]

# Last arg can be treated same as root
-position enum(root, non-last-arg, before-dot)
-augment enum(not, force)
-with-augment void(out char8 builder, augment augment?, name symbol)
	with-augment out, augment, {out ~~= name.to}
-with-augment void(out char8 builder, augment augment?, f void mut())
	if augment == not
		out ~= "!"
	f[]
	if augment == force
		out ~= "!"

-translate-to-keen void(out char8 builder, a java-expr, position position, augment augment?)
	match a
	as java-bogus
		out ~~= "bogus"
	as symbol
		with-augment out, augment, a
	as java-call
		translate-call-to-keen out, a, position, augment
	as java-dot
		write-keen-call out, a.name, (a.left,), position, augment
-translate-call-to-keen void(out char8 builder, a java-call, position position, augment augment?)
	args = a.args
	match called = a.called
	as java-bogus
		out ~~= "bogus"
	as symbol
		if is-empty args
			with-augment out, augment, called
		else
			write-keen-call out, called, args, position, augment
	as java-call
		with-augment out, augment, of
			translate-to-keen out, called, position, ()
			out ~= "["
			write-with-commas out, args, of arg, pos
				translate-to-keen out, arg, pos, ()
			out ~= "]"
	as java-dot
		write-keen-call out, called.name, called.left ~ args, position, augment

-write-keen-call void
	out char8 builder
	name symbol
	args java-expr[]
	position position
	augment augment?
do
	arg0 = args[0]
	rest-args = args[1 .. end]
	if is-empty rest-args
		new-augment augment? = if augment
			()
		else
			name.to
		if new-augment
			translate-to-keen out, arg0, position, new-augment
		elif position == root
			with-augment out, augment, name
			out ~= " "
			translate-to-keen out, arg0, root, ()
		else
			with-augment out, augment, of
				translate-to-keen out, arg0, before-dot, ()
				out ~= "."
				out ~~= name.to
	else
		needs-parens bool = match position
		as root
			false
		as non-last-arg
			true
		as before-dot
			true
		if needs-parens
			out ~= "("
		with-augment out, augment, name
		out ~= " "
		translate-to-keen out, arg0, non-last-arg, ()
		out ~~= ", "
		write-with-commas out, rest-args, of arg, pos
			translate-to-keen out, arg, pos, ()
		if needs-parens
			out ~= ")"

| Also represents C expressions
-java-expr union(java-bogus, symbol, java-call, java-dot)
-java-bogus record
-java-call record(called java-expr, args java-expr[])
-java-dot record(left java-expr, name symbol)

-parse-ctx record(diags pos mut[]) mut
-add-diag void(ctx parse-ctx, cur string-iterator)
	ctx.diags ~= cur.pos

-parse-java-expr (java-expr, pos[])(source string)
	ctx parse-ctx = (),
	iter = begin source
	res = parse-java-expr-recur ctx, iter
	skip-whitespace iter
	unless iter.is-at-end
		add-diag ctx, iter
	res, ctx.diags.move-to

-parse-java-expr-recur java-expr(ctx parse-ctx, iter string-iterator)
	skip-whitespace iter
	if name = try-take-keen-identifier iter
		parse-java-expr-suffixes ctx, iter, name
	else
		add-diag ctx, iter
		java-bogus
-parse-java-expr-suffixes java-expr(ctx parse-ctx, iter string-iterator, lhs java-expr)
	skip-whitespace iter
	if try-take iter, "."
		if name = try-take-keen-identifier iter
			parse-java-expr-suffixes ctx, iter, java-dot lhs, name
		else
			add-diag ctx, iter
			lhs
	elif try-take iter, "("
		args java-expr[] = if try-take iter, ")"
			()
		else
			do with out in build
			while
				out ~= parse-java-expr-recur ctx, iter
				skip-whitespace iter
				try-take iter, ","
			unless try-take iter, ")"
				add-diag ctx, iter
		parse-java-expr-suffixes ctx, iter, java-call lhs, args
	else
		lhs

test
	test-both-ways "a", "a"
	test-both-ways "f a", "f(a)"
	test-both-ways "h g f a", "h(g(f(a)))"
	test-both-ways "f a, b", "f(a, b)"
	test-both-ways "f a, b, c", "f(a, b, c)"
	test-both-ways "f a.g, b, c", "f(g(a), b, c)"
	test-both-ways "f a.g, b.h, c", "f(g(a), h(b), c)"
	test-both-ways "f (g a, b), c, d", "f(g(a, b), c, d)"
	test-both-ways "f (g a, b, c), d, e", "f(g(a, b, c), d, e)"
	test-both-ways "f (g a, b), (h c, d), i e", "f(g(a, b), h(c, d), i(e))"

	test-one-way c, "f(a) x", keen, "f a", (5,)
	test-one-way keen, "x\n", c, "", (0,)

-test-both-ways void(keen-src string, c-src string)
	test-one-way keen, keen-src, c, c-src, ()
	test-one-way c, c-src, keen, keen-src, ()

-test-one-way void(from language, source string, to language, expected string, expected-diagnostics pos[])
	result = syntax-translate (source, from, to)
	result.diagnostics is expected-diagnostics
	result.output is expected
